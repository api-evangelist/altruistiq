  "item": [
    {
      "id": "9aa24883-a74b-4198-a985-d0f5bdc76505",
      "name": "Datasource",
      "description": {
        "content": "### Altruistiq’s datasource API enables you to:\n\n  - Create new datasources\n  - Manage existing datasources (read, update)\n  - Upload data to a datasource\n\nA datasource is the place where you will share a single data format with altruistiq and where you will categorise it so that we can calculate emissions in an automated way.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1ecb6a4e-481d-4b1d-9677-fe4fbcf67650",
          "name": "Start A Multipart Upload",
          "request": {
            "name": "Start A Multipart Upload",
            "description": {
              "content": "Use this endpoint to start your multipart upload and retrieve an uploadId and fileId.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "public",
                "v1",
                "datasource",
                ":dataSourceId",
                "upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "userEmail",
                  "value": "<string>",
                  "description": "(Required) Email of user initiating upload."
                },
                {
                  "disabled": false,
                  "key": "fileName",
                  "value": "<string>",
                  "description": "(Required) Name of file that is being uploaded."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dataSourceId",
                  "description": "(Required) ID of datasource"
